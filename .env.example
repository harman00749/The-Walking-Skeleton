# Backend (copy these values into server/.env)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/taskmatrix-auth
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key

# Frontend (set in Vercel)
VITE_API_URL=http://localhost:5000/api
